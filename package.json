{
  "name": "monarch",
  "version": "0.1.0",
  "private": true,
  "description": "An ERC-4337 paymaster that lets a consumer app pay its users' gas",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "forge build",
    "test": "forge test",
    "lint": "solhint 'contracts/**/*.sol'",
    "fmt": "forge fmt && forge fmt cases && prettier --write '**/*.{md,json,yml}'",
    "fmt:check": "forge fmt --check && forge fmt --check cases && prettier --check '**/*.{md,json,yml}'",
    "snapshot": "FOUNDRY_PROFILE=gas forge snapshot --no-match-path 'test/{invariant,fork}/*'",
    "analyze": "slither .",
    "snapshot:check": "FOUNDRY_PROFILE=gas forge snapshot --check --no-match-path 'test/{invariant,fork}/*'",
    "test:fork": "FOUNDRY_PROFILE=fork forge test",
    "test:cases": "FOUNDRY_PROFILE=cases forge test"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "prettier-plugin-solidity": "^2.4.1",
    "solhint": "^5.0.5"
  }
}
