{
  "name": "monarch",
  "version": "0.1.0",
  "private": true,
  "description": "An ERC-4337 paymaster that lets a consumer app pay its users' gas",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "forge build",
    "test": "forge test",
    "lint": "solhint 'contracts/**/*.sol'",
    "fmt": "forge fmt && prettier --write '**/*.{md,json,yml}'",
    "fmt:check": "forge fmt --check && prettier --check '**/*.{md,json,yml}'",
    "snapshot": "forge snapshot",
    "analyze": "slither ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "solhint": "^5.0.5"
  }
}
