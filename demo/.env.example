# ---------------------------------------------------------------------------
# Browser-visible (VITE_ prefixed). Everything here ends up in the bundle.
# ---------------------------------------------------------------------------
VITE_PAYMASTER_ADDRESS=0x0000000000000000000000000000000000000000
VITE_GUESTBOOK_ADDRESS=0x0000000000000000000000000000000000000000
VITE_APP_ADDRESS=0x0000000000000000000000000000000000000000
VITE_RPC_URL=https://sepolia.base.org
# Any ERC-4337 v0.8 bundler endpoint for Base Sepolia (chain 84532).
VITE_BUNDLER_URL=

# ---------------------------------------------------------------------------
# Server only. NEVER prefix these with VITE_ — that would publish the signer
# key to every visitor. The app signer authorises sponsorships; it holds no
# funds itself, but anyone with it can spend the app's entire budget.
# ---------------------------------------------------------------------------
APP_SIGNER_PRIVATE_KEY=
PAYMASTER_ADDRESS=0x0000000000000000000000000000000000000000
APP_ADDRESS=0x0000000000000000000000000000000000000000
RPC_URL=https://sepolia.base.org
PORT=8787
# How long a sponsorship stays valid, in seconds. Short by design: the
# signature is a bearer authorisation for the app's money.
SPONSORSHIP_TTL_SEC=120
