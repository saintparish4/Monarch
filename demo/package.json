{
  "name": "monarch-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A wallet holding zero ETH writes to a contract, paid for by the app",
  "scripts": {
    "dev": "concurrently -n server,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && tsx --test shared/*.test.ts && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "tsx --test shared/*.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "permissionless": "^0.2.28",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.23.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
