# Copy to .env (git-ignored). Base Sepolia only — use keys that have never held
# mainnet funds and never will.

# Owner of the paymaster, and the demo app. Funds the stake, buffer and budget.
DEPLOYER_PRIVATE_KEY=
# The app's sponsorship signer. Read only by the demo's server route.
APP_SIGNER_PRIVATE_KEY=

BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BUNDLER_URL=https://public.pimlico.io/v2/84532/rpc

# Optional. Only needed to verify source on Basescan; Sourcify and Blockscout
# need no key.
BASESCAN_API_KEY=

# Deploy amounts, in wei. Defaults shown. `addStake` is additive, so start small
# and top up if a bundler asks for more.
# STAKE_WEI=10000000000000000
# UNSTAKE_DELAY_SEC=86400
# OWNER_BUFFER_WEI=1000000000000000
# APP_BUDGET_WEI=5000000000000000
